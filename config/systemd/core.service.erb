[Unit]
Description=<%= fetch(:application) %> application core server
After=network.target remote-fs.target nss-lookup.target
Requires=redis.service postgresql.service
# restart on failure https://ma.ttias.be/auto-restart-crashed-service-systemd/
StartLimitIntervalSec=500
StartLimitBurst=35

[Service]
Type=simple
User=_nginx
Group=_nginx
Environment=RAILS_ENV=<%= fetch(:rails_env) %>
WorkingDirectory=<%= current_path %>
ExecStart=/bin/bash -lc '/usr/bin/rvm 3.1.4@dneslov --create do bundle exec foreman start -f config/procfiles/<%= fetch(:rails_env) %>.rb -d .'
StandardInput=null
StandardOutput=journal
StandardError=journal+console
TimeoutSec=30
Restart=always
RestartSec=30s

[Install]
WantedBy=multi-user.target
