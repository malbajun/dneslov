<%=
   react_component('MemoriesForm',
      date: !@date.blank? && @date.strftime("%d.%m.%Y"),
      error: (binding.local_variable_get(:error) rescue nil),
      calendaries_cloud: (binding.local_variable_get(:cloud) rescue nil),
      calendaries_used: @calendary_slugs,
      user: session["user"],
      rites: binding.local_variable_get(:rites),
      total: binding.local_variable_get(:total),
      range: binding.local_variable_get(:range))
-%>
